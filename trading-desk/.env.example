# Application
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_desk
REDIS_URL=redis://localhost:6379/0

# Auth (single operator)
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
JWT_SECRET_KEY=change-me-jwt-secret
JWT_EXPIRE_MINUTES=10080

# OANDA (primary market data)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_API_URL=https://api-fxpractice.oanda.com

# Twelve Data (fallback cross-check only)
TWELVE_DATA_API_KEY=

# Finnhub (news/calendar)
FINNHUB_API_KEY=

# MetaApi (execution only — never for analysis candles)
METAAPI_TOKEN=

# Claude Agent SDK
ANTHROPIC_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Encryption for stored credentials
CREDENTIALS_ENCRYPTION_KEY=

# Rate limits
CHAT_RATE_LIMIT_PER_MINUTE=20
BOT_ORDER_MIN_INTERVAL_SECONDS=30
PRICE_DIVERGENCE_THRESHOLD_PCT=0.15
